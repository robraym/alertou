<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="0dp"
    android:paddingEnd="16dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_card_inset"
        android:layout_marginEnd="@dimen/screen_card_inset"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:baselineAligned="true"
            android:paddingTop="4dp"
            android:gravity="top"
            android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:gravity="top"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/button_sort_offers"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/dashboard_sort_title"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sort" />

        <ImageButton
            android:id="@+id/button_profile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/profile_screen_title"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/floating_search_content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:id="@+id/navigation_animated_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/screen_card_inset"
        android:layout_marginTop="@dimen/screen_header_content_gap"
        android:layout_marginEnd="@dimen/screen_card_inset"
        android:layout_marginBottom="6dp"
        android:orientation="vertical"
        android:padding="0dp">

        <ScrollView
            android:id="@+id/floating_search_dismiss_surface"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="58dp">

            <LinearLayout
                android:id="@+id/container_offers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

        <include layout="@layout/view_floating_search" />
    </FrameLayout>

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
