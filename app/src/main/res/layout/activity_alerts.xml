<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_card_inset"
        android:layout_marginEnd="@dimen/screen_card_inset"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:baselineAligned="true"
            android:paddingTop="4dp"
            android:gravity="top"
            android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:gravity="top"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/alerts_screen_title"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:textStyle="bold" />
            <include layout="@layout/view_app_status" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/button_sort_alerts"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/alerts_sort_title"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sort" />

        <ImageButton
            android:id="@+id/button_profile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/profile_screen_title"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/floating_search_content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/screen_header_content_gap"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/navigation_animated_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_card_inset"
        android:paddingEnd="@dimen/screen_card_inset"
        android:paddingBottom="58dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_compact"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/header_coupon_alerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_pressed"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp">

                <ImageButton
                    android:id="@+id/button_add_coupon_interest"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/action_add_coupon_alert"
                    android:padding="5dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_add_coupon_alert" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="@string/coupon_alerts_list_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/text_coupon_alerts_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:singleLine="true"
                        android:text="@string/coupon_alerts_registered_count_empty"
                        android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/button_toggle_coupon_alerts"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/alerts_section_collapse"
                    android:padding="7dp"
                    android:rotation="90"
                    android:scaleType="center"
                    android:src="@drawable/ic_chevron_right" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_coupon_interests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_compact"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/header_property_alerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_pressed"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp">

                <ImageButton
                    android:id="@+id/button_add_property_interest"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/action_add_property_alert"
                    android:padding="5dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_add_property_alert" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="@string/property_alerts_list_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/text_property_alerts_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:singleLine="true"
                        android:text="@string/property_alerts_registered_count_empty"
                        android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/button_toggle_property_alerts"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/alerts_section_collapse"
                    android:padding="7dp"
                    android:rotation="90"
                    android:scaleType="center"
                    android:src="@drawable/ic_chevron_right" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_property_interests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_compact"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/header_price_alerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_pressed"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp">

                <ImageButton
                    android:id="@+id/button_add_price_interest"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/action_add_price_alert"
                    android:padding="5dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_add_price_alert" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="@string/product_alerts_list_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/text_price_alerts_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:singleLine="true"
                        android:text="@string/price_alerts_registered_count_empty"
                        android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/button_toggle_price_alerts"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/alerts_section_collapse"
                    android:padding="7dp"
                    android:rotation="90"
                    android:scaleType="center"
                    android:src="@drawable/ic_chevron_right" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_price_interests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>

        <include layout="@layout/view_floating_search" />
    </FrameLayout>

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
